<%- include('../partials/head', { title: 'Extensions', active: 'extensions' }) %>

<div class="sec-head">
  <span class="sec-title">Extensions</span>
  <div style="display:flex;align-items:center;gap:10px">
    <span class="muted" style="font-size:11px" id="ext-summary"></span>
    <% if (role === 'admin') { %>
    <button class="btn btn-sm btn-danger" onclick="regenAll()">Regenerate All Passwords</button>
    <button class="btn btn-sm" onclick="showAddForm()">+ Add extension</button>
    <% } %>
  </div>
</div>

<% if (role === 'admin') { %>
<!-- Add extension form -->
<div id="add-form" style="display:none; margin-bottom:16px;" class="card">
  <form onsubmit="addExtension(event)">
    <div class="grid-2" style="margin-bottom:0">
      <div class="form-group"><label class="form-label">Extension</label><input class="form-input" id="new-ext" placeholder="2004" required></div>
      <div class="form-group"><label class="form-label">Name</label><input class="form-input" id="new-name" placeholder="User Four" required></div>
    </div>
    <div style="display:flex;gap:8px;margin-top:8px">
      <button type="submit" class="btn btn-primary btn-sm">Create</button>
      <button type="button" class="btn btn-sm" onclick="hideAddForm()">Cancel</button>
      <span class="muted" style="font-size:11px;align-self:center">A secure password will be auto-generated</span>
    </div>
  </form>
</div>
<% } %>

<!-- Password result modal -->
<div id="pw-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:100;display:none;align-items:center;justify-content:center">
  <div class="card" style="max-width:600px;width:90%;max-height:80vh;overflow-y:auto">
    <div class="card-head">
      <span class="card-title" id="pw-modal-title">New Password</span>
      <button class="act-btn" onclick="closePwModal()" title="Close">
        <svg viewBox="0 0 24 24" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="pw-modal-body"></div>
    <div style="display:flex;gap:8px;margin-top:14px">
      <button class="btn btn-primary btn-sm" onclick="downloadCsv()">Download CSV</button>
      <button class="btn btn-sm" onclick="copyPasswords()">Copy to clipboard</button>
      <button class="btn btn-sm" onclick="closePwModal()">Close</button>
    </div>
  </div>
</div>

<table class="tbl">
  <thead><tr><th>Status</th><th>Extension</th><th>Name</th><th>Presence</th><th>User agent</th><th>IP address</th><th>Expires</th><th>Ext. SIP</th><th></th></tr></thead>
  <tbody id="ext-body">
    <tr><td colspan="9" class="empty">Loading...</td></tr>
  </tbody>
</table>

<script>
var API = '/api';
// Browser calls authenticate with the login session cookie, sent automatically
// on same-origin requests. KEY stays empty: the server no longer puts a shared
// secret in the page, and /api enforces the logged-in user's role per route.
var KEY = '<%= apiKey %>';
var headers = { 'X-API-Key': KEY };
var J = { 'X-API-Key': KEY, 'Content-Type': 'application/json' };
var lastPasswordResults = [];
var myRole = '<%= typeof role !== "undefined" ? role : "admin" %>';

function showAddForm() { document.getElementById('add-form').style.display = 'block'; }
function hideAddForm() { document.getElementById('add-form').style.display = 'none'; }

function presencePill(p, remote) {
  if (!p || p === 'idle') return '<span class="pill p-info">ready</span>';
  if (p === 'ringing') return '<span class="pill p-ring">ringing</span>' + (remote ? ' <span class="mono muted" style="font-size:10px">' + esc(remote) + '</span>' : '');
  if (p === 'confirmed') return '<span class="pill p-ok">in call</span>' + (remote ? ' <span class="mono muted" style="font-size:10px">' + esc(remote) + '</span>' : '');
  if (p === 'held') return '<span class="pill p-hold">on hold</span>' + (remote ? ' <span class="mono muted" style="font-size:10px">' + esc(remote) + '</span>' : '');
  if (p === 'dnd') return '<span class="pill p-miss">DND</span>';
  return '<span class="pill p-gray">' + esc(p) + '</span>';
}

function statusDot(reg, presence) {
  if (!reg) return '<span class="dot dot-gray" title="Offline"></span>';
  if (presence === 'ringing') return '<span class="dot dot-amber" title="Ringing" style="animation:pulse 0.6s infinite"></span>';
  if (presence === 'confirmed') return '<span class="dot dot-red" title="In call"></span>';
  if (presence === 'held') return '<span class="dot dot-blue" title="On hold"></span>';
  if (presence === 'dnd') return '<span class="dot dot-red" title="DND"></span>';
  return '<span class="dot dot-green" title="Available"></span>';
}

function esc(s) { if (!s) return ''; var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

// ─── Load extensions ───
async function loadExtensions() {
  try {
    var r = await fetch(API + '/extensions', { headers: headers });
    var d = await r.json();
    if (!d.success) return;
    var tbody = document.getElementById('ext-body');

    if (!d.extensions.length) {
      tbody.innerHTML = '<tr><td colspan="9" class="empty">No extensions configured</td></tr>';
      document.getElementById('ext-summary').textContent = '';
      return;
    }

    var online = 0, inCall = 0;
    d.extensions.forEach(function(e) {
      if (e.registered) online++;
      if (e.presence === 'confirmed' || e.presence === 'ringing' || e.presence === 'held') inCall++;
    });
    document.getElementById('ext-summary').textContent = online + ' online' + (inCall > 0 ? ', ' + inCall + ' in call' : '');

    window.__lastExts = d.extensions;
    tbody.innerHTML = d.extensions.map(function(e) {
      var reg = e.registered;
      var c0 = (e.contacts && e.contacts.length > 0) ? e.contacts[0] : {};
      var p = e.presence || 'idle';

      return '<tr>' +
        '<td>' + statusDot(reg, p) + '</td>' +
        '<td class="mono">' + esc(e.extension) + '</td>' +
        '<td>' + esc(e.name || '') +
          (e.webAccess ? ' <span class="pill p-ok" style="font-size:9px" title="Web access: ' + esc((e.webUser && e.webUser.username) || '') + ' (' + esc((e.webUser && e.webUser.role) || '') + ')">web</span>' : '') +
        '</td>' +
        '<td>' + (reg ? presencePill(p, e.presenceRemote) : '<span class="pill p-gray">offline</span>') + '</td>' +
        '<td class="muted" style="font-size:11px">' + esc(c0.userAgent || '-') + '</td>' +
        '<td class="mono" style="font-size:11px">' + (reg ? esc(c0.ip + ':' + c0.port) : '-') + '</td>' +
        '<td class="muted">' + (c0.expires ? formatExpires(c0.expires) : '-') + '</td>' +
        '<td data-sip-ext="' + esc(e.extension) + '">' + (myRole === 'admin'
          ? sipToggleHtml(e.extension, e.allowExternalCalls)
          : (getSipState(e.extension, e.allowExternalCalls) ? '<span class="pill p-ok" style="font-size:10px">SIP</span>' : '<span class="muted" style="font-size:10px">—</span>')) +
        '</td>' +
        '<td style="white-space:nowrap">' +
          (myRole === 'admin'
            ? '<button class="act-btn" title="Extension settings" onclick="openExtSettings(\'' + esc(e.extension) + '\')">' +
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>' +
              '</button>' +
              '<button class="act-btn" title="Regenerate password" onclick="regenOne(\'' + esc(e.extension) + '\',\'' + esc(e.name) + '\')">' +
                '<svg viewBox="0 0 24 24" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0115.36-6.36L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 01-15.36 6.36L3 16"/></svg>' +
              '</button>' +
              '<button class="act-btn" title="Delete" onclick="deleteExt(\'' + esc(e.extension) + '\')">' +
                '<svg viewBox="0 0 24 24" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>' +
              '</button>'
            : '') +
        '</td>' +
      '</tr>';
    }).join('');
  } catch (err) { console.error('ext load', err); }
}

function formatExpires(exp) {
  if (!exp) return '-';
  var d = new Date(exp);
  var secs = Math.max(0, Math.round((d.getTime() - Date.now()) / 1000));
  if (secs <= 0) return 'expired';
  return secs + 's';
}

// ─── Generate secure random password ───
function generatePassword() {
  var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  var pw = '';
  var arr = new Uint8Array(16);
  crypto.getRandomValues(arr);
  for (var i = 0; i < 16; i++) pw += chars[arr[i] % chars.length];
  return pw;
}

// ─── Add extension ───
async function addExtension(e) {
  e.preventDefault();
  var ext = document.getElementById('new-ext').value.trim();
  var name = document.getElementById('new-name').value.trim();
  var password = generatePassword();

  var r = await fetch(API + '/extensions', {
    method: 'POST', headers: J,
    body: JSON.stringify({ extension: ext, name: name, password: password })
  });
  var d = await r.json();
  if (d.success) {
    hideAddForm();
    document.getElementById('new-ext').value = '';
    document.getElementById('new-name').value = '';
    lastPasswordResults = [{ extension: ext, name: name, password: password }];
    showPwModal('Extension Created — ' + ext);
    showToast('Extension ' + ext + ' created');
  } else {
    showToast(d.error || 'Failed', true);
  }
  loadExtensions();
}

// ─── Delete extension ───
async function deleteExt(ext) {
  if (!confirm('Delete extension ' + ext + '?')) return;
  await fetch(API + '/extensions/' + ext, { method: 'DELETE', headers: headers });
  showToast('Extension deleted');
  loadExtensions();
}

// ─── Regenerate single password ───
async function regenOne(ext, name) {
  if (!confirm('Regenerate password for ' + ext + ' (' + name + ')?\n\nThe current password will be replaced immediately.\nThe softphone will need to be re-configured.')) return;
  var r = await fetch(API + '/extensions/' + ext + '/regenerate-password', { method: 'POST', headers: J });
  var d = await r.json();
  if (d.success) {
    lastPasswordResults = [{ extension: d.extension, name: d.name, password: d.password }];
    showPwModal('New Password — Extension ' + ext);
    showToast('Password regenerated for ' + ext);
  } else {
    showToast(d.error || 'Failed', true);
  }
}

// ─── Regenerate ALL passwords ───
async function regenAll() {
  if (!confirm('Regenerate passwords for ALL extensions?\n\n⚠ This will replace every extension password immediately.\nAll softphones will need to be re-configured.\n\nMake sure to download the CSV after regeneration.')) return;
  var r = await fetch(API + '/extensions/regenerate-all', { method: 'POST', headers: J });
  var d = await r.json();
  if (d.success && d.extensions) {
    lastPasswordResults = d.extensions;
    showPwModal('Regenerated Passwords — ' + d.extensions.length + ' Extensions');
    showToast(d.extensions.length + ' passwords regenerated');
  } else {
    showToast(d.error || 'Failed', true);
  }
}

// ─── Password modal ───
function showPwModal(title) {
  document.getElementById('pw-modal-title').textContent = title;
  var html = '<table class="tbl"><thead><tr><th>Extension</th><th>Name</th><th>New Password</th></tr></thead><tbody>';
  html += lastPasswordResults.map(function(r) {
    return '<tr>' +
      '<td class="mono">' + esc(r.extension) + '</td>' +
      '<td>' + esc(r.name) + '</td>' +
      '<td><code style="background:var(--bg-surface);padding:3px 8px;border-radius:4px;font-family:var(--mono);font-size:13px;user-select:all">' + esc(r.password) + '</code></td>' +
    '</tr>';
  }).join('');
  html += '</tbody></table>';
  document.getElementById('pw-modal-body').innerHTML = html;
  document.getElementById('pw-modal').style.display = 'flex';
}

function closePwModal() {
  document.getElementById('pw-modal').style.display = 'none';
  lastPasswordResults = [];
  loadExtensions();
}

// ─── Download CSV ───
function downloadCsv() {
  if (!lastPasswordResults.length) return;
  var csv = 'Extension,Name,Password\n';
  lastPasswordResults.forEach(function(r) {
    csv += '"' + r.extension + '","' + (r.name || '').replace(/"/g, '""') + '","' + r.password + '"\n';
  });
  var blob = new Blob([csv], { type: 'text/csv' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = 'shadowpbx-extensions-' + new Date().toISOString().split('T')[0] + '.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('CSV downloaded');
}

// ─── Copy to clipboard ───
function copyPasswords() {
  if (!lastPasswordResults.length) return;
  var text = lastPasswordResults.map(function(r) {
    return r.extension + '\t' + (r.name || '') + '\t' + r.password;
  }).join('\n');
  navigator.clipboard.writeText(text).then(function() {
    showToast('Copied to clipboard');
  }).catch(function() {
    // Fallback
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showToast('Copied to clipboard');
  });
}

// ─── External SIP toggle state ───
// Local overrides that survive table refreshes until confirmed by API
var sipOverrides = {}; // ext -> true/false (pending saves)

function getSipState(ext, serverValue) {
  // If we have a local override, use it; otherwise use server value
  return sipOverrides.hasOwnProperty(ext) ? sipOverrides[ext] : !!serverValue;
}

function sipToggleHtml(ext, serverValue) {
  var on = getSipState(ext, serverValue);
  var pending = sipOverrides.hasOwnProperty(ext);
  return '<button class="btn btn-sm" style="font-size:10px;min-width:44px;padding:2px 8px;' +
    (on ? 'background:var(--color-ok);color:#fff;border-color:var(--color-ok)' : '') +
    (pending ? ';opacity:0.7' : '') +
    '" onclick="toggleExtSIP(\'' + esc(ext) + '\',' + !on + ')">' +
    (on ? '● ON' : '○ OFF') + '</button>';
}

async function toggleExtSIP(ext, enabled) {
  // Optimistic update — set local override immediately
  sipOverrides[ext] = enabled;
  // Re-render just this button without full table refresh
  var cells = document.querySelectorAll('[data-sip-ext="' + ext + '"]');
  cells.forEach(function(td) { td.innerHTML = sipToggleHtml(ext, enabled); });

  try {
    var r = await fetch(API + '/extensions/' + ext, {
      method: 'PUT', headers: J,
      body: JSON.stringify({ allowExternalCalls: enabled })
    });
    var d = await r.json();
    if (d.success) {
      showToast('External SIP ' + (enabled ? 'enabled' : 'disabled') + ' for ' + ext);
      // Clear override — server now has the correct value
      delete sipOverrides[ext];
    } else {
      showToast(d.error || 'Failed', true);
      // Revert override
      delete sipOverrides[ext];
    }
  } catch (e) {
    showToast('Failed to update', true);
    delete sipOverrides[ext];
  }
}

// ─── Toast ───
function showToast(msg, isError) {
  var el = document.createElement('div');
  el.className = 'toast ' + (isError ? 'toast-error' : 'toast-success');
  el.textContent = msg;
  document.body.appendChild(el);
  setTimeout(function() { el.remove(); }, 3000);
}

loadExtensions();
setInterval(loadExtensions, 3000);
</script>


<!-- ── Extension settings modal ── -->
<div id="ext-settings-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:200;align-items:center;justify-content:center" onclick="if(event.target===this)closeExtSettings()">
  <div class="card" style="max-width:460px;width:90%;max-height:85vh;overflow-y:auto">
    <div class="card-head">
      <span class="card-title">Extension <span id="es-ext" class="mono"></span> settings</span>
      <button class="act-btn" onclick="closeExtSettings()">
        <svg viewBox="0 0 24 24" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="form-group">
      <label class="form-label">Agent name</label>
      <input class="form-input" id="es-name" placeholder="e.g. Jane Doe">
    </div>

    <div class="form-group">
      <label class="form-label">SIP password</label>
      <div style="display:flex;gap:8px">
        <input class="form-input mono" id="es-password" style="flex:1" placeholder="leave blank to keep current" autocomplete="new-password">
        <button class="btn btn-sm" type="button" onclick="genExtPassword()">Generate</button>
      </div>
      <span class="muted" style="font-size:11px">This is the phone's SIP secret, used by the softphone to register. The web login has its own separate password.</span>
    </div>

    <div style="border-top:1px solid var(--border,#333);margin:14px 0;padding-top:14px">
      <div class="card-head" style="margin-bottom:8px"><span class="card-title" style="font-size:13px">Web access</span></div>
      <div id="es-web-body">
        <div class="muted">Checking…</div>
      </div>
    </div>

    <div id="es-footer" style="display:flex;gap:8px;align-items:center;margin-top:8px">
      <button class="btn btn-primary btn-sm" onclick="saveExtSettings()">Save changes</button>
      <button class="btn btn-sm" onclick="closeExtSettings()">Cancel</button>
    </div>
    <div style="margin-top:6px"><span class="muted" id="es-msg" style="font-size:12px"></span></div>
  </div>
</div>

<script>
var esCurrent = null;   // { extension, name }

function openExtSettings(ext) {
  esCurrent = { extension: ext };
  document.getElementById('es-ext').textContent = ext;
  document.getElementById('es-msg').textContent = '';
  document.getElementById('es-password').value = '';
  document.getElementById('es-web-body').innerHTML = '<div class="muted">Checking…</div>';
  // name from the row we already loaded
  var row = (window.__lastExts || []).find(function (e) { return e.extension === ext; });
  document.getElementById('es-name').value = row ? (row.name || '') : '';
  var footer = document.getElementById('es-footer');
  if (footer) footer.style.display = 'flex';
  document.getElementById('ext-settings-modal').style.display = 'flex';
  loadWebAccess(ext);
}
function closeExtSettings() { document.getElementById('ext-settings-modal').style.display = 'none'; }

function genExtPassword() {
  var c = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
  var p = '';
  var a = new Uint32Array(16); (window.crypto || {}).getRandomValues && window.crypto.getRandomValues(a);
  for (var i = 0; i < 16; i++) p += c[(a[i] || Math.floor(Math.random() * 1e9)) % c.length];
  document.getElementById('es-password').value = p;
}

async function loadWebAccess(ext) {
  var body = document.getElementById('es-web-body');
  try {
    var r = await fetch(API + '/extensions/' + encodeURIComponent(ext) + '/web-access', { headers: headers, credentials: 'same-origin' });
    var d = await r.json();
    if (!d.success) { body.innerHTML = '<span class="muted">' + esc(d.error || 'unavailable') + '</span>'; return; }

    if (d.attached && !d.managedHere) {
      // Attached to a privileged / external account — cannot toggle here.
      body.innerHTML =
        '<div class="mc-row" style="margin-bottom:6px"><span class="pill p-hold">attached</span>' +
        '<span style="font-size:12px">Linked to <b>' + esc(d.user.username) + '</b> (' + esc(d.user.role) + ')</span></div>' +
        '<div class="muted" style="font-size:12px">This extension is tied to an existing account. To change or remove web access, detach it in ' +
        '<a href="/settings#users">Settings → Users</a> first.</div>';
    } else if (d.attached) {
      body.innerHTML =
        '<div class="mc-row" style="margin-bottom:8px"><span class="pill p-ok">enabled</span>' +
        '<span style="font-size:12px">Agent login <b>' + esc(d.user.username) + '</b></span></div>' +
        '<div class="form-group"><label class="form-label">Reset web password</label>' +
          '<div style="display:flex;gap:8px">' +
            '<input class="form-input mono" id="es-web-pass" style="flex:1" placeholder="new web password (min 8)" autocomplete="new-password">' +
            '<button class="btn btn-sm" type="button" onclick="genWebPassword()">Generate</button>' +
          '</div>' +
          '<span class="muted" style="font-size:11px">Separate from the SIP password.</span>' +
        '</div>' +
        '<div style="display:flex;gap:8px">' +
          '<button class="btn btn-primary btn-sm" onclick="setWebAccess(true)">Reset password</button>' +
          '<button class="btn btn-sm btn-danger" onclick="setWebAccess(false)">Disable web access</button>' +
        '</div>';
    } else {
      body.innerHTML =
        '<div class="muted" style="font-size:12px;margin-bottom:8px">No web login. Enabling creates an agent account ' +
        '(username = extension) with its own web password, so this agent can sign into the web UI.</div>' +
        '<div class="form-group"><label class="form-label">Web password</label>' +
          '<div style="display:flex;gap:8px">' +
            '<input class="form-input mono" id="es-web-pass" style="flex:1" placeholder="web password (min 8)" autocomplete="new-password">' +
            '<button class="btn btn-sm" type="button" onclick="genWebPassword()">Generate</button>' +
          '</div>' +
          '<span class="muted" style="font-size:11px">Independent of the SIP password.</span>' +
        '</div>' +
        '<button class="btn btn-primary btn-sm" onclick="setWebAccess(true)">Enable web access</button>';
    }
  } catch (e) {
    body.innerHTML = '<span class="muted">' + esc(e.message) + '</span>';
  }
}

function genWebPassword() {
  var el = document.getElementById('es-web-pass');
  if (!el) return;
  var c = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
  var p = '', a = new Uint32Array(16);
  (window.crypto || {}).getRandomValues && window.crypto.getRandomValues(a);
  for (var i = 0; i < 16; i++) p += c[(a[i] || Math.floor(Math.random() * 1e9)) % c.length];
  el.value = p;
  el.type = 'text';   // reveal a generated password so the admin can copy it
}

async function setWebAccess(enable) {
  var ext = esCurrent.extension;
  var opts = { method: enable ? 'POST' : 'DELETE', headers: J, credentials: 'same-origin' };
  var pw = '';
  if (enable) {
    var passEl = document.getElementById('es-web-pass');
    pw = passEl ? passEl.value.trim() : '';
    if (pw.length < 8) { document.getElementById('es-msg').textContent = 'Enter a web password of at least 8 characters (or Generate one).'; return; }
    opts.body = JSON.stringify({ password: pw });
  }
  try {
    var r = await fetch(API + '/extensions/' + encodeURIComponent(ext) + '/web-access', opts);
    var d = await r.json();
    if (!d.success) { document.getElementById('es-msg').textContent = d.error || 'Failed'; return; }
    loadExtensions();
    if (enable) {
      // Show the password ONE LAST TIME so the admin can copy it, then close.
      showWebPasswordThenClose(ext, pw, d.reset);
    } else {
      closeExtSettings();
    }
  } catch (e) {
    document.getElementById('es-msg').textContent = e.message;
  }
}

// Confirmation view: the login and its password shown once, with a Copy button,
// then the modal closes when the admin dismisses it.
function showWebPasswordThenClose(ext, pw, wasReset) {
  var body = document.getElementById('es-web-body');
  body.innerHTML =
    '<div class="mc-row" style="margin-bottom:8px"><span class="pill p-ok">' + (wasReset ? 'password reset' : 'enabled') + '</span></div>' +
    '<div class="muted" style="font-size:12px;margin-bottom:8px">Give these to the agent. The password is shown only now — it can\'t be retrieved later, only reset.</div>' +
    '<table class="tbl" style="margin:0 0 10px"><tbody>' +
      '<tr><td style="color:var(--text-secondary)">Sign-in URL</td><td class="mono" style="font-size:12px">' + location.origin + '/login</td></tr>' +
      '<tr><td style="color:var(--text-secondary)">Username</td><td class="mono">' + esc(ext) + '</td></tr>' +
      '<tr><td style="color:var(--text-secondary)">Password</td><td class="mono" id="es-shown-pw">' + esc(pw) + '</td></tr>' +
    '</tbody></table>' +
    '<button class="btn btn-sm" onclick="copyWebCreds(\'' + esc(ext) + '\', \'' + esc(pw).replace(/\\/g,'\\\\').replace(/\'/g, "\\'") + '\')">Copy</button> ' +
    '<button class="btn btn-primary btn-sm" onclick="closeExtSettings()">Done</button>';
  // Hide the Save/Cancel footer while showing the one-time credentials
  var footer = document.getElementById('es-footer');
  if (footer) footer.style.display = 'none';
}

function copyWebCreds(ext, pw) {
  var text = 'Sign in: ' + location.origin + '/login\nUsername: ' + ext + '\nPassword: ' + pw;
  (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(function () {
    document.getElementById('es-msg').textContent = 'Copied to clipboard';
  }).catch(function () {
    document.getElementById('es-msg').textContent = 'Copy failed — select the password manually';
  });
}

async function saveExtSettings(silent) {
  var ext = esCurrent.extension;
  var payload = { name: document.getElementById('es-name').value.trim() };
  var pw = document.getElementById('es-password').value.trim();
  if (pw) payload.password = pw;
  try {
    var r = await fetch(API + '/extensions/' + encodeURIComponent(ext), {
      method: 'PUT', headers: J,
      credentials: 'same-origin', body: JSON.stringify(payload)
    });
    var d = await r.json();
    if (!d.success) { document.getElementById('es-msg').textContent = d.error || 'Save failed'; return; }
    document.getElementById('es-password').value = '';
    loadExtensions();
    if (!silent) closeExtSettings();   // close on a successful explicit save
  } catch (e) {
    document.getElementById('es-msg').textContent = e.message;
  }
}
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeExtSettings(); });
</script>

