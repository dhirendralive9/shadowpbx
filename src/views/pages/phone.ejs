<%- include('../partials/head', { title: 'Phone', active: 'phone' }) %>

<style>
  .ph-wrap{max-width:900px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .ph-full{grid-column:1 / -1}
  .ph-meter{height:8px;border-radius:4px;background:var(--bg-surface,#1a1a1a);overflow:hidden;border:0.5px solid var(--border)}
  .ph-meter>i{display:block;height:100%;width:0;background:var(--green,#30a46c);transition:width .08s linear}
  .ph-meter.mic>i{background:var(--blue,#4a8cff)}
  .ph-kv{display:flex;justify-content:space-between;gap:10px;padding:4px 0;border-bottom:0.5px solid var(--border);font-size:12px}
  .ph-kv:last-child{border-bottom:0}
  .ph-log{font-family:ui-monospace,monospace;font-size:11px;max-height:170px;overflow:auto;line-height:1.6}
  .ph-big{font-size:22px;font-weight:600;margin:4px 0}
  @media(max-width:820px){.ph-wrap{grid-template-columns:1fr}}
</style>

<div class="ph-wrap">

  <div class="card ph-full">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <div>
        <div style="font-weight:600">Browser phone</div>
        <div class="muted" style="font-size:12px">Signed in as <span class="mono" id="ph-ext-label">—</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        <span class="pill p-gray" id="ph-reg">offline</span>
        <select class="form-input" id="ph-pick" style="width:auto;min-width:190px"></select>
        <button class="btn btn-sm btn-primary" id="ph-connect" onclick="phConnect()">Go online</button>
        <button class="btn btn-sm" id="ph-disconnect" onclick="phDisconnect()" style="display:none">Go offline</button>
      </div>
    </div>
    <div class="muted" id="ph-note" style="font-size:12px;margin-top:8px"></div>
  </div>

  <div class="card ph-full" id="ph-incoming" style="display:none;border-left:3px solid var(--amber,#f5a623)">
    <div class="muted" style="font-size:11px">Incoming call</div>
    <div class="ph-big" id="ph-caller">—</div>
    <button class="btn btn-sm btn-primary" onclick="phAnswer()">Answer</button>
    <button class="btn btn-sm" style="color:var(--red,#e5484d)" onclick="phReject()">Decline</button>
  </div>

  <div class="card">
    <div class="muted" style="font-size:11px">Call</div>
    <div class="ph-big" id="ph-peer">idle</div>
    <div class="muted mono" style="font-size:12px" id="ph-timer">00:00</div>

    <div style="display:flex;gap:8px;margin:12px 0">
      <input class="form-input" id="ph-dial" placeholder="extension or number" style="flex:1">
      <button class="btn btn-sm btn-primary" id="ph-call" onclick="phCall()" disabled>Call</button>
    </div>
    <div>
      <button class="btn btn-sm" id="ph-mute" onclick="phMute()" disabled>Mute</button>
      <button class="btn btn-sm" id="ph-hangup" onclick="phHangup()" disabled style="color:var(--red,#e5484d)">Hang up</button>
    </div>

    <div style="margin-top:14px">
      <div class="muted" style="font-size:11px;display:flex;justify-content:space-between"><span>Speaker</span><span id="ph-spk-db">—</span></div>
      <div class="ph-meter"><i id="ph-spk"></i></div>
      <div class="muted" style="font-size:11px;margin-top:8px;display:flex;justify-content:space-between"><span>Microphone</span><span id="ph-mic-db">—</span></div>
      <div class="ph-meter mic"><i id="ph-mic"></i></div>
    </div>
  </div>

  <div class="card">
    <div class="muted" style="font-size:11px;margin-bottom:6px">Audio</div>
    <div class="ph-kv"><span class="muted">Codec</span><span class="mono" id="ph-codec">—</span></div>
    <div class="ph-kv"><span class="muted">ICE / DTLS</span><span class="mono" id="ph-ice">—</span></div>
    <div class="ph-kv"><span class="muted">Packets sent / recv</span><span class="mono" id="ph-pkts">—</span></div>
    <div class="ph-kv"><span class="muted">Packets lost</span><span class="mono" id="ph-lost">—</span></div>
    <div class="ph-kv"><span class="muted">Jitter</span><span class="mono" id="ph-jit">—</span></div>
    <div class="ph-kv"><span class="muted">Round trip</span><span class="mono" id="ph-rtt">—</span></div>
  </div>

  <div class="card ph-full">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <span class="muted" style="font-size:11px">Log</span>
      <button class="btn btn-sm" onclick="document.getElementById('ph-log').innerHTML=''">Clear</button>
    </div>
    <div class="ph-log muted" id="ph-log"></div>
  </div>
</div>

<audio id="ph-audio" autoplay playsinline></audio>

<script src="/vendor/sip-0.21.2.min.js"></script>
<script>
var CFG = <%- JSON.stringify(webrtcConfig || {}) %>;

var ua=null, registerer=null, session=null, incoming=null;
var muted=false, timer=null, startedAt=0, statsTimer=null, meterTimer=null;
var actx=null, micAn=null, spkAn=null, micSrc=null, spkSrc=null, creds=[];

function el(i){return document.getElementById(i);}
function pill(i,t,c){var n=el(i);n.textContent=t;n.className='pill '+(c||'p-gray');}
function note(t){el('ph-note').textContent=t||'';}
function log(m){
  var d=new Date().toTimeString().slice(0,8);
  var n=el('ph-log');
  n.innerHTML+='['+d+'] '+String(m).replace(/</g,'&lt;')+'<br>';
  n.scrollTop=n.scrollHeight;
}

function actxGet(){
  if(!actx) actx=new (window.AudioContext||window.webkitAudioContext)();
  if(actx.state==='suspended') actx.resume();
  return actx;
}
var ringIv=null, ringOsc=null;
function ringStart(){
  ringStop();
  try{
    var c=actxGet(), on=false;
    ringIv=setInterval(function(){
      on=!on;
      if(on){
        var o=c.createOscillator(), g=c.createGain();
        o.type='sine'; o.frequency.value=440; g.gain.value=0.10;
        o.connect(g); g.connect(c.destination); o.start(); ringOsc={o:o,g:g};
        setTimeout(function(){ try{o.stop();}catch(e){} },700);
      }
    },1400);
  }catch(e){}
}
function ringStop(){
  if(ringIv){clearInterval(ringIv);ringIv=null;}
  if(ringOsc){try{ringOsc.o.stop();}catch(e){} ringOsc=null;}
}
function tone(freq,ms,vol){
  try{
    var c=actxGet(), o=c.createOscillator(), g=c.createGain();
    o.type='sine'; o.frequency.value=freq; g.gain.value=vol||0.12;
    o.connect(g); g.connect(c.destination); o.start();
    setTimeout(function(){try{o.stop();}catch(e){}}, ms);
  }catch(e){}
}
function toneHangup(){ tone(400,180); setTimeout(function(){tone(300,260);},190); }
function toneAnswer(){ tone(660,120,0.08); }

function meterStart(pc){
  meterStop();
  try{
    var c=actxGet();
    var rx=new MediaStream(), tx=new MediaStream();
    pc.getReceivers().forEach(function(r){ if(r.track&&r.track.kind==='audio') rx.addTrack(r.track); });
    pc.getSenders().forEach(function(s){ if(s.track&&s.track.kind==='audio') tx.addTrack(s.track); });
    if(rx.getAudioTracks().length){ spkSrc=c.createMediaStreamSource(rx); spkAn=c.createAnalyser(); spkAn.fftSize=512; spkSrc.connect(spkAn); }
    if(tx.getAudioTracks().length){ micSrc=c.createMediaStreamSource(tx); micAn=c.createAnalyser(); micAn.fftSize=512; micSrc.connect(micAn); }
    var buf=new Uint8Array(256);
    meterTimer=setInterval(function(){
      var pairs=[[spkAn,'ph-spk','ph-spk-db'],[micAn,'ph-mic','ph-mic-db']];
      pairs.forEach(function(x){
        if(!x[0]) return;
        x[0].getByteTimeDomainData(buf);
        var sum=0;
        for(var i=0;i<buf.length;i++){ var v=(buf[i]-128)/128; sum+=v*v; }
        var rms=Math.sqrt(sum/buf.length);
        el(x[1]).style.width=Math.min(100, Math.round(rms*220))+'%';
        el(x[2]).textContent=rms>0.001?(Math.round(20*Math.log10(rms))+' dB'):'—';
      });
    },100);
  }catch(e){}
}
function meterStop(){
  if(meterTimer){clearInterval(meterTimer);meterTimer=null;}
  try{ if(spkSrc) spkSrc.disconnect(); }catch(e){}
  try{ if(micSrc) micSrc.disconnect(); }catch(e){}
  spkSrc=null; micSrc=null; spkAn=null; micAn=null;
  el('ph-spk').style.width='0'; el('ph-mic').style.width='0';
  el('ph-spk-db').textContent='—'; el('ph-mic-db').textContent='—';
}

function statsStart(pc){
  statsStop();
  statsTimer=setInterval(function(){
    pc.getStats(null).then(function(rep){
      var out={};
      rep.forEach(function(s){
        if(s.type==='inbound-rtp'&&s.kind==='audio'){ out.recv=s.packetsReceived; out.lost=s.packetsLost; out.jit=s.jitter; }
        if(s.type==='outbound-rtp'&&s.kind==='audio'){ out.sent=s.packetsSent; }
        if(s.type==='candidate-pair'&&s.state==='succeeded'&&s.nominated){ out.rtt=s.currentRoundTripTime; }
        if(s.type==='codec'&&s.mimeType&&s.mimeType.indexOf('audio')===0){ out.codec=s.mimeType+'/'+s.clockRate; }
      });
      el('ph-pkts').textContent=(out.sent!=null?out.sent:'—')+' / '+(out.recv!=null?out.recv:'—');
      el('ph-lost').textContent=out.lost!=null?out.lost:'—';
      el('ph-jit').textContent=out.jit!=null?(Math.round(out.jit*1000)+' ms'):'—';
      el('ph-rtt').textContent=out.rtt!=null?(Math.round(out.rtt*1000)+' ms'):'—';
      if(out.codec) el('ph-codec').textContent=out.codec;
      el('ph-ice').textContent=pc.iceConnectionState+' / '+(pc.connectionState||'');
    }).catch(function(){});
  },1000);
}
function statsStop(){ if(statsTimer){clearInterval(statsTimer);statsTimer=null;} }

function tick(){
  var s=Math.floor((Date.now()-startedAt)/1000);
  el('ph-timer').textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
}
function callerOf(s){
  try{
    var u=s.remoteIdentity.uri.user, d=s.remoteIdentity.displayName;
    return d?(d+' ('+u+')'):(u||'Unknown');
  }catch(e){ return 'Unknown'; }
}
function pcOf(s){ try{ return s.sessionDescriptionHandler.peerConnection; }catch(e){ return null; } }

function onEstablished(s){
  ringStop(); toneAnswer();
  el('ph-incoming').style.display='none';
  el('ph-peer').textContent=callerOf(s);
  el('ph-mute').disabled=false; el('ph-hangup').disabled=false;
  startedAt=Date.now(); tick(); timer=setInterval(tick,1000);
  var pc=pcOf(s);
  if(pc){
    try{
      var ms=new MediaStream();
      pc.getReceivers().forEach(function(r){ if(r.track&&r.track.kind==='audio') ms.addTrack(r.track); });
      el('ph-audio').srcObject=ms;
    }catch(e){}
    statsStart(pc); meterStart(pc);
  }
  log('Call established with '+callerOf(s));
}
function resetCall(why, playTone){
  ringStop(); statsStop(); meterStop();
  if(playTone) toneHangup();
  el('ph-incoming').style.display='none';
  el('ph-peer').textContent='idle';
  el('ph-timer').textContent='00:00';
  el('ph-mute').disabled=true; el('ph-hangup').disabled=true; el('ph-mute').textContent='Mute';
  var f=['ph-codec','ph-ice','ph-pkts','ph-lost','ph-jit','ph-rtt'];
  f.forEach(function(i){ el(i).textContent='—'; });
  if(timer){clearInterval(timer);timer=null;}
  session=null; incoming=null; muted=false;
  if(why){ note(why); log(why); }
}
function bind(s){
  s.stateChange.addListener(function(st){
    if(st===SIP.SessionState.Establishing) log('Connecting…');
    if(st===SIP.SessionState.Established) onEstablished(s);
    if(st===SIP.SessionState.Terminated) resetCall('Call ended.', true);
  });
}

function loadCreds(){
  return fetch('/phone/api/extensions',{credentials:'same-origin'})
    .then(function(r){return r.json();})
    .then(function(d){
      creds=(d&&d.extensions)||[];
      var sel=el('ph-pick');
      if(!creds.length){ sel.innerHTML='<option value="">no extension</option>'; note('No extension is assigned to you.'); return; }
      sel.innerHTML=creds.map(function(c){
        return '<option value="'+c.extension+'">'+c.extension+(c.name?' \u00b7 '+c.name:'')+'</option>';
      }).join('');
    }).catch(function(e){ note('Could not load extensions: '+e.message); });
}

function phConnect(){
  var ext=el('ph-pick').value;
  var c=null;
  for(var i=0;i<creds.length;i++){ if(creds[i].extension===ext) c=creds[i]; }
  if(!c){ note('Pick an extension first.'); return; }
  if(!CFG.wssUrl){ note('WebRTC is not configured on this server.'); return; }
  actxGet();
  note('Connecting…'); log('Signing in as '+ext);

  ua=new SIP.UserAgent({
    uri: SIP.UserAgent.makeURI('sip:'+ext+'@'+CFG.sipDomain),
    authorizationUsername: ext,
    authorizationPassword: c.password,
    transportOptions:{ server: CFG.wssUrl },
    sessionDescriptionHandlerFactoryOptions:{ peerConnectionConfiguration:{ iceServers: CFG.iceServers||[] } },
    delegate:{
      onInvite:function(inv){
        if(session){ try{inv.reject();}catch(e){} return; }
        incoming=inv;
        el('ph-caller').textContent=callerOf(inv);
        el('ph-incoming').style.display='';
        log('Incoming call from '+callerOf(inv));
        ringStart();
        bind(inv);
        inv.stateChange.addListener(function(st){
          if(st===SIP.SessionState.Terminated && session!==inv) resetCall('Missed call.', false);
        });
      }
    }
  });

  ua.start().then(function(){
    log('WebSocket connected: '+CFG.wssUrl);
    registerer=new SIP.Registerer(ua,{expires:300});
    registerer.stateChange.addListener(function(st){
      if(st===SIP.RegistererState.Registered){
        pill('ph-reg','online','p-ok');
        el('ph-call').disabled=false;
        el('ph-connect').style.display='none';
        el('ph-disconnect').style.display='';
        el('ph-pick').disabled=true;
        el('ph-ext-label').textContent=ext;
        note('Ready to take calls.'); log('Registered');
      } else if(st===SIP.RegistererState.Unregistered){
        pill('ph-reg','offline','p-gray'); el('ph-call').disabled=true; log('Unregistered');
      }
    });
    return registerer.register();
  }).catch(function(e){ note('Could not connect: '+e.message); log('Error: '+e.message); });
}

function phDisconnect(){
  try{ if(registerer) registerer.unregister(); }catch(e){}
  try{ if(ua) ua.stop(); }catch(e){}
  ua=null; registerer=null; resetCall('', false);
  pill('ph-reg','offline','p-gray');
  el('ph-connect').style.display=''; el('ph-disconnect').style.display='none';
  el('ph-pick').disabled=false; el('ph-call').disabled=true;
  el('ph-ext-label').textContent='—'; log('Signed out');
}

function phAnswer(){
  if(!incoming) return;
  ringStop(); session=incoming;
  incoming.accept({sessionDescriptionHandlerOptions:{constraints:{audio:true,video:false}}})
    .catch(function(e){ note('Answer failed: '+e.message); resetCall('', false); });
  el('ph-incoming').style.display='none';
}
function phReject(){
  if(!incoming) return;
  try{ incoming.reject(); }catch(e){}
  resetCall('Call declined.', false);
}
function phHangup(){
  if(!session) return;
  try{
    if(session.state===SIP.SessionState.Established) session.bye();
    else session.cancel();
  }catch(e){}
  resetCall('Call ended.', true);
}
function phMute(){
  var pc=pcOf(session); if(!pc) return;
  muted=!muted;
  pc.getSenders().forEach(function(s){ if(s.track&&s.track.kind==='audio') s.track.enabled=!muted; });
  el('ph-mute').textContent=muted?'Unmute':'Mute';
  log(muted?'Microphone muted':'Microphone unmuted');
}
function phCall(){
  var dest=el('ph-dial').value.trim(); if(!dest||!ua) return;
  var inviter=new SIP.Inviter(ua, SIP.UserAgent.makeURI('sip:'+dest+'@'+CFG.sipDomain),
    {sessionDescriptionHandlerOptions:{constraints:{audio:true,video:false}}});
  session=inviter; bind(inviter);
  el('ph-peer').textContent=dest; el('ph-hangup').disabled=false;
  note('Calling '+dest+'…'); log('Calling '+dest);
  inviter.invite().catch(function(e){ note('Call failed: '+e.message); resetCall('', false); });
}

loadCreds();
if(!CFG.wssUrl) note('WebRTC is not configured on this server yet.');
window.addEventListener('beforeunload',function(){ try{ if(registerer) registerer.unregister(); }catch(e){} });
</script>

<%- include('../partials/foot') %>
