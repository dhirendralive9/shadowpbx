<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change password — ShadowPBX</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-box">
      <div class="login-brand">
        <div class="brand-mark"></div>
        <span class="brand-name">ShadowPBX</span>
        <span class="brand-tag">v3.0</span>
      </div>

      <% if (forced) { %>
        <p class="login-title">Set a new password</p>
        <p class="muted" style="font-size:13px;margin:-6px 0 14px">
          You're signed in with a temporary password. Choose a new one to continue.
        </p>
      <% } else { %>
        <p class="login-title">Change your password</p>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/change-password" autocomplete="off">
        <!-- decoy fields to absorb Chrome autofill -->
        <input type="text" style="position:absolute;opacity:0;height:0;width:0" tabindex="-1" autocomplete="username" aria-hidden="true">
        <input type="password" style="position:absolute;opacity:0;height:0;width:0" tabindex="-1" autocomplete="new-password" aria-hidden="true">

        <% if (!forced) { %>
        <div class="form-group">
          <label class="form-label" for="currentPassword">Current password</label>
          <input class="form-input" type="password" id="currentPassword" name="currentPassword" autocomplete="new-password" required>
        </div>
        <% } %>

        <div class="form-group">
          <label class="form-label" for="newPassword">New password</label>
          <input class="form-input" type="password" id="newPassword" name="newPassword" minlength="8" autocomplete="new-password" required autofocus>
        </div>
        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm new password</label>
          <input class="form-input" type="password" id="confirmPassword" name="confirmPassword" minlength="8" autocomplete="new-password" required>
        </div>

        <button type="submit" class="btn btn-primary login-btn" style="width:100%">
          <%= forced ? 'Set password and continue' : 'Change password' %>
        </button>
      </form>

      <% if (!forced) { %>
        <p style="text-align:center;margin-top:14px"><a href="/" class="muted" style="font-size:12px">Cancel</a></p>
      <% } else { %>
        <p style="text-align:center;margin-top:14px"><a href="/logout" class="muted" style="font-size:12px">Sign out</a></p>
      <% } %>
    </div>
  </div>
</body>
</html>
