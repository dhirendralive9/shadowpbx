{
  "name": "shadowpbx",
  "version": "3.0.0",
  "description": "Self-hosted Node.js PBX — SIP + WebRTC calling, ring groups, IVR, queues, predictive dialer, CRM integration and an embeddable browser call widget",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "setup": "bash scripts/install-drachtio.sh",
    "setup:webrtc": "bash scripts/setup-webrtc.sh",
    "setup:turn": "bash scripts/setup-turn.sh",
    "test:webrtc": "node scripts/webrtc-selftest.js",
    "test:webcall": "node scripts/webcall-selftest.js",
    "test:wss": "node scripts/wss-register-probe.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "drachtio-fn-b2b-sugar": "^0.2.1",
    "drachtio-srf": "^5.0.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "mongoose": "^7.6.0",
    "multer": "^2.1.1",
    "rtpengine-client": "^0.4.12",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "pbx",
    "sip",
    "voip",
    "nodejs",
    "drachtio",
    "call-recording",
    "telephony",
    "ring-group",
    "trunk",
    "webrtc",
    "web-dialer",
    "click-to-call",
    "predictive-dialer",
    "crm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhirendralive9/shadowpbx"
  }
}
