# ShadowPBX Configuration
# Copy to .env and edit values

# Drachtio Server
DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=change_me

# SIP Settings
SIP_DOMAIN=your-domain-or-ip
SIP_PORT=5060
EXTERNAL_IP=your-server-ip

# RTPEngine
RTPENGINE_HOST=127.0.0.1
RTPENGINE_PORT=22222

# MongoDB (authenticated)
MONGODB_URI=mongodb://shadowpbx:change_me@127.0.0.1:27017/shadowpbx?authSource=shadowpbx

# Recordings
RECORDINGS_DIR=/var/lib/shadowpbx/recordings
RECORDING_FORMAT=wav

# Express API
API_PORT=3000
ADMIN_SECRET=change_me

# Security
MAX_REGISTER_ATTEMPTS=5
REGISTER_BAN_DURATION=300
SIP_RATE_LIMIT=20
LOG_LEVEL=info

# Appointment Webhooks (Twilio/SignalWire/Telnyx)
# Public URL where carriers can reach your server
# WEBHOOK_BASE_URL=https://your-domain.com

# Carrier API Credentials (for AMD-enabled dialer campaigns)
# TELNYX_API_KEY=KEYxxxxxxxx
# TELNYX_CONNECTION_ID=1494404757140276705
# SIGNALWIRE_PROJECT_ID=your-project-id
# SIGNALWIRE_API_TOKEN=your-api-token
# SIGNALWIRE_SPACE=your-space.signalwire.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx

# WebRTC (browser calling — Web Dialer Phase 1)
# Browsers connect to wss://<WEB_DOMAIN>/ws (nginx -> Drachtio 127.0.0.1:5061)
# WEB_DOMAIN=pbx.your-domain.com
# WSS_URL=wss://pbx.your-domain.com/ws
WEBRTC_ENABLED=true
# g711 = strip Opus/G722 toward phones (no transcoding, recordings work)
# pcmu = PCMU only | transcode = let RTPEngine transcode Opus<->G.711
WEBRTC_CODEC_POLICY=g711
WEBRTC_DTLS_ANSWER=passive
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302

# Web dialer guests (Web Dialer Phase 2)
# Short-lived browser identities: one token = one call, one destination.
WEBCALL_ENABLED=true
WEBCALL_TOKEN_TTL=60            # seconds an unused token stays valid
WEBCALL_MAX_CALL_MINUTES=60     # hard cap on a single web call
WEBCALL_TOKENS_PER_IP=10        # token requests per IP per window
WEBCALL_RATE_WINDOW=600         # window in seconds
WEBCALL_MAX_CONCURRENT=10       # fallback cap when a widget sets none

# Web dialer abuse prevention (Phase 7)
WEBCALL_TOKENS_PER_WIDGET=60     # token requests per widget per window
WEBCALL_ABUSE_BLOCK_AFTER=0      # refusals from one IP before an iptables block; 0 = report only
# Optional CAPTCHA (Cloudflare Turnstile). Leave blank to disable entirely —
# widgets can only require a challenge when a secret is set here.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# TURN relay for browsers behind strict NAT (Phase 8 — scripts/setup-turn.sh writes these)
# TURN_URLS=turn:pbx.your-domain.com:3478?transport=udp,turns:pbx.your-domain.com:5349?transport=tcp
# TURN_SECRET=
TURN_TTL=3600

# Self-update (Settings → System)
UPDATE_ENABLED=true              # set false to hide the one-click updater
UPDATE_BRANCH=main               # branch to track
UPDATE_SERVICE_NAME=shadowpbx    # systemd unit restarted after updating

# ── Toll-fraud protection (added after the 2026-09-25 incident) ──
# Outbound destination guard. Applied to every outbound call (dialled,
# click-to-call, dialer), independent of the route patterns.
#
# Allow-list: only these dial prefixes may be called. STRONGLY recommended —
# set it to the countries you actually do business in. Empty = allow all
# except the blocked list below. Example for US/Canada + UK:
# OUTBOUND_ALLOWED_PREFIXES=1,44
#
# Always-blocked prefixes (applied even with no allow-list). Defaults to
# high-risk satellite/premium ranges; override to customise.
# OUTBOUND_BLOCKED_PREFIXES=870,871,872,873,874,881,882,883,979,236,900
#
# Reject numbers longer than this many digits (E.164 max is 15).
OUTBOUND_MAX_LENGTH=15

# ── Trunk trust (anti-spoofing for inbound) ──
# Trunk traffic is identified by SOURCE IP, resolved from each trunk's host.
# If your provider sends from an SBC or IP range that differs from the host's
# DNS, list those IPs here (comma-separated) so genuine calls are trusted.
# Leaving this blank is fine when the host resolves to the sending IPs.
# TRUNK_TRUSTED_IPS=

# ── Login hardening ──
LOGIN_MAX_FAILS=5              # failed logins per IP before lockout
LOGIN_WINDOW_SECONDS=300       # window the failures are counted in
LOGIN_LOCKOUT_SECONDS=900      # lockout duration after too many failures

# ── Credential encryption (separate from the API auth secret) ──
# Dedicated 32-byte key for encrypting CRM credentials at rest. Generate with:
#   openssl rand -hex 32
# If unset, ADMIN_SECRET is used (legacy). Setting this lets you rotate the API
# secret without making previously-encrypted CRM credentials undecryptable.
# CREDENTIAL_ENCRYPTION_KEY=

# ── Fatal-error policy ──
# On an uncaught exception, exit so the supervisor restarts from clean state
# (recommended for a SIP server). Set false only to keep a possibly-inconsistent
# process alive.
CRASH_ON_UNCAUGHT=true


# ADMIN_PASSWORD — optional. Sets the first admin password on an empty database.
# If unset, a strong temporary password is generated and printed ONCE to the log
# at first start; you must change it on first login. No default password exists.
# ADMIN_PASSWORD=

# ── Carrier webhook security ──
# Verify that /webhook/* requests genuinely came from the carrier (Twilio /
# SignalWire signature). Do NOT disable in production — these endpoints change
# call state and download recordings.
WEBHOOK_VERIFY=true
# The canonical public URL of this PBX. REQUIRED for correct signature
# verification and safe callback URLs — do not let these be built from request
# headers. e.g. https://pbx.example.com
# WEBHOOK_BASE_URL=https://pbx.your-domain.com

# Extra hostnames allowed as recording sources (comma-separated, suffix match).
# The major carriers are built in; add yours only if it serves recordings from
# another domain. Recording downloads are https-only and refuse private IPs.
# RECORDING_ALLOWED_HOSTS=

# ── Proxy / session / trunk trust ──
# Express trust-proxy setting so req.ip is the real client via OUR nginx (not a
# spoofable header). 'loopback' trusts only 127.0.0.1/::1. Use a hop count or
# subnet if you run more trusted proxies in front.
TRUST_PROXY=loopback

# How often (seconds) a live session is re-checked against the user's current
# state (disabled / role / extension / password change take effect within this).
SESSION_REVALIDATE_SECONDS=30

# TRUNK_TRUSTED_IPS accepts both exact IPs and CIDR blocks, comma-separated,
# e.g. 203.0.113.10,198.51.100.0/24
# (documented above where TRUNK_TRUSTED_IPS is defined)

# Refuse to issue web-call tokens for a widget that has no allowedDomains
# (i.e. forbid globally-embeddable widgets). Default false: allowed but warned.
# WEBCALL_REQUIRE_ALLOWED_DOMAINS=false

# ── IP intelligence (Security → attack monitor enrichment) ──
# Enrich attacker IPs with proxy/VPN/datacenter/risk/geo data. Cached, fail-open
# (the page still lists IPs if these are unset or the APIs are down). Display
# only — never auto-blocks.
# PROXYCHECK_API_KEY=        # proxycheck.io key (primary; free tier ~1000/day)
# IPLOCATE_API_KEY=          # iplocate.io key (geo/ASN + fallback)
# IPLOCATE_KEYLESS=false     # true to use iplocate's keyless tier
IP_INTEL_ENABLED=true
IP_INTEL_TTL_HOURS=24


# ── Real-time voice interpreter (feat/voice-interpreter) ──
# Live two-way call translation. OFF by default: a call is translated only when
# it is explicitly flagged AND this master switch is true. With it false,
# behaviour is byte-for-byte unchanged — safe to merge to main dormant.
TRANSLATION_ENABLED=false

# Deepgram — one key covers streaming STT (Nova-3) and TTS (Aura).
# console.deepgram.com — new accounts get $200 free credit.
DEEPGRAM_API_KEY=
TRANSLATION_STT_MODEL=nova-3
TRANSLATION_TTS_MODEL=aura-2

# DeepL — text translation. A key ending in ':fx' is a free-tier key and is
# routed to api-free.deepl.com automatically; any other key uses api.deepl.com.
# deepl.com/pro-api — free tier is 500k characters/month.
DEEPL_API_KEY=

# Default customer language per translated route; 'auto' detects from the first
# few seconds of speech. Agent language comes from the ring group / queue.
TRANSLATION_DEFAULT_CUSTOMER_LANG=auto

# Cost guards (Phase 10). Per-call hard cap in minutes, and an optional monthly
# USD ceiling above which translation auto-disables (calls fall back to normal).
TRANSLATION_MAX_CALL_MINUTES=30
# TRANSLATION_MONTHLY_CAP_USD=

# ── Interpreter port ──
# A second listener that agent applications open a translation socket on. The
# agent's app terminates the call's media itself and sends only synthesised
# speech into the call, which is what keeps the agent's real voice away from
# the customer: rtpengine cannot mute a leg toward its peer while still
# forking it to the recogniser, so the microphone must never enter the call in
# the first place.
#
# Bound to loopback by default. In production nginx proxies /interpreter/ws on
# the main HTTPS vhost, so the socket inherits that certificate. Change the
# bind address only if a desktop app must reach the port directly, and
# firewall it if you do — this is an audio socket.
INTERPRETER_PORT=3002
INTERPRETER_BIND=127.0.0.1

# How many translated calls may run at once, server-wide. Each one holds an
# open Deepgram connection that bills while it lives.
INTERPRETER_MAX_SESSIONS=20
# Hard ceiling on one session, in ms. Catches a forgotten tab left streaming.
INTERPRETER_MAX_CALL_MS=7200000
# How long a connect token stays usable. It only has to cross the gap between
# the page loading and the socket opening, and it is consumed on first use.
INTERPRETER_TOKEN_TTL_MS=120000

# Override the URL handed to agent applications. Leave unset and clients are
# pointed at /interpreter/ws on the host they are already talking to, which is
# what you want behind nginx. Set it (e.g. wss://pbx.example.com:3002) only
# when the port is reachable directly.
# INTERPRETER_PUBLIC_URL=

# Speech gate. We only stream audio while there is something to hear, because
# Deepgram bills for what we send and an agent is listening most of the call.
# The threshold is RMS on the mu-law scale (±32124): room noise sits near 100,
# telephone speech near 1600-3200. Lower it if quiet speakers get clipped,
# raise it if a noisy room keeps the gate open.
INTERPRETER_GATE_RMS=900
# How long the gate stays open after speech stops, so the pauses inside a
# sentence do not chop it into fragments.
INTERPRETER_GATE_TAIL_MS=700

# ── Voice interpreter — deferred providers (wire in later) ──
# Groq Whisper — optional cleaner post-call transcript re-pass (Phase 9). Off for
# now; live Deepgram STT still produces transcripts without it.
TRANSLATION_POSTCALL_TRANSCRIBE=false
# GROQ_API_KEY=
# Google Translate — long-tail-language fallback for pairs DeepL doesn't cover.
# Needs a GCP project with billing + the Cloud Translation API enabled.
# GOOGLE_TRANSLATE_KEY=